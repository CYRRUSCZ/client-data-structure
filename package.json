{
    "name": "@cyrrus/clientdatastructure",
    "version": "8.2.1",
    "description": "A common structure for CYRRUS client data as used in DocHub and other integrations",
    "type": "module",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "main": "./dist/index.cjs",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint ./src",
        "test": "node ./testBuild.mjs && jest",
        "docs": "typedoc --out docs src"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CYRRUSCZ/clientdatastructure.git"
    },
    "keywords": [
        "cyrrus",
        "client"
    ],
    "author": "tvaliasek",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CYRRUSCZ/clientdatastructure/issues"
    },
    "homepage": "https://github.com/CYRRUSCZ/clientdatastructure#readme",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.2",
        "esbuild": "0.24.2",
        "eslint": "^9.17.0",
        "eslint-config-love": "^114.0.0",
        "eslint-config-prettier": "^9.1.0",
        "ibantools": "^4.5.1",
        "jest": "^29.7.0",
        "libphonenumber-js": "^1.11.20",
        "prettier": "^3.4.2",
        "tsup": "^8.4.0",
        "typedoc": "^0.27.6",
        "typescript": "^5.7.2"
    },
    "publishConfig": {
        "registry": "https://vrdc.cyrrus.cz"
    },
    "peerDependencies": {
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.2",
        "ibantools": "^4.5.1",
        "libphonenumber-js": "^1.11.20"
    },
    "dependencies": {
        "@cyrrus/locale-utils": "^1.1.0"
    }
}
