{
    "name": "@cyrrus/client-data-structure",
    "version": "9.2.0",
    "description": "A common structure for CYRRUS client data as used in DocHub and other integrations",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./*": {
            "import": {
                "types": "./dist/*.d.mts",
                "default": "./dist/*.mjs"
            },
            "require": {
                "types": "./dist/*.d.cts",
                "default": "./dist/*.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "lint": "eslint --config eslint.config.ts --fix --quiet",
        "test": "jest",
        "docs": "typedoc --out docs src"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CYRRUSCZ/client-data-structure.git"
    },
    "keywords": [
        "cyrrus",
        "client"
    ],
    "author": "tvaliasek",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CYRRUSCZ/client-data-structure/issues"
    },
    "homepage": "https://github.com/CYRRUSCZ/client-data-structure#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/jest": "^30.0.0",
        "ajv": "^8.18.0",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.3",
        "eslint": "^10.0.3",
        "ibantools": "^4.5.1",
        "jest": "^30.3.0",
        "libphonenumber-js": "^1.12.40",
        "ts-jest": "^29.4.6",
        "tsconfig-paths": "^4.2.0",
        "tsdown": "^0.21.4",
        "type-fest": "^5.4.4",
        "typedoc": "^0.28.17",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1",
        "jiti": "^2.6.1"
    },
    "publishConfig": {
        "registry": "https://vrdc.cyrrus.cz"
    },
    "peerDependencies": {
        "ajv": "^8.18.0",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.3",
        "ibantools": "^4.5.1",
        "libphonenumber-js": "^1.12.40"
    },
    "dependencies": {
        "@cyrrus/clientdatastructure": "^8.2.1",
        "@cyrrus/locale-utils": "^2.0.0"
    }
}
