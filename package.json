{
    "name": "@cyrrus/client-data-structure",
    "version": "9.0.0",
    "description": "A common structure for CYRRUS client data as used in DocHub and other integrations",
    "type": "module",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "main": "./dist/index.cjs",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint ./src",
        "test": "node ./testBuild.mjs && jest",
        "docs": "typedoc --out docs src"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CYRRUSCZ/client-data-structure.git"
    },
    "keywords": [
        "cyrrus",
        "client"
    ],
    "author": "tvaliasek",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CYRRUSCZ/client-data-structure/issues"
    },
    "homepage": "https://github.com/CYRRUSCZ/client-data-structure#readme",
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.5.0",
        "@stylistic/eslint-plugin-migrate": "^4.4.1",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.2",
        "esbuild": "0.25.11",
        "eslint": "^9.38.0",
        "ibantools": "^4.5.1",
        "jest": "^30.2.0",
        "libphonenumber-js": "^1.12.24",
        "ts-jest": "^29.4.5",
        "tsconfig-paths": "^4.2.0",
        "tsup": "^8.5.0",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    },
    "publishConfig": {
        "registry": "https://vrdc.cyrrus.cz"
    },
    "peerDependencies": {
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.2",
        "ibantools": "^4.5.1",
        "libphonenumber-js": "^1.12.24"
    },
    "dependencies": {
        "@cyrrus/clientdatastructure": "^8.2.1",
        "@cyrrus/locale-utils": "^1.1.0"
    }
}
