{
    "name": "@cyrrus/clientdatastructure",
    "version": "8.0.1",
    "description": "A common structure for CYRRUS client data as used in DocHub and other integrations",
    "type": "module",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/client-data-structure.esm.js",
            "require": "./dist/client-data-structure.cjs"
        },
        "./dist/client-data-structure": {
            "import": "./dist/client-data-structure.esm.js",
            "require": "./dist/client-data-structure.cjs"
        },
        "./package.json": "./package.json"
    },
    "module": "dist/client-data-structure.esm.js",
    "main": "dist/client-data-structure.cjs",
    "scripts": {
        "build": "node ./build.mjs",
        "run:example:validations": "node ./examples.mjs && node ./dist/exampleValidations.esm.js",
        "lint": "eslint ./src",
        "postbuild": "tsc --emitDeclarationOnly --declaration",
        "test": "jest",
        "docs": "typedoc --out docs src"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CYRRUSCZ/clientdatastructure.git"
    },
    "keywords": [
        "cyrrus",
        "client"
    ],
    "author": "tvaliasek",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CYRRUSCZ/clientdatastructure/issues"
    },
    "homepage": "https://github.com/CYRRUSCZ/clientdatastructure#readme",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "esbuild": "0.24.2",
        "eslint": "^9.17.0",
        "eslint-config-love": "^114.0.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "typedoc": "^0.27.6",
        "typescript": "^5.7.2"
    },
    "publishConfig": {
        "registry": "https://vrdc.cyrrus.cz"
    },
    "dependencies": {
        "@cyrrus/locale-utils": "^1.1.0",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cdigit": "^4.0.2",
        "libphonenumber-js": "^1.11.20"
    }
}
